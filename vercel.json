{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?cmdmudanzas\\.com\\.ar"
        }
      ],
      "destination": "https://www.cmdmudanzas.com/:path*",
      "permanent": true
    },
    {
      "source": "/mudanzas-empresariales",
      "destination": "/#tipos",
      "permanent": true
    },
    {
      "source": "/mudanzas-compartidas",
      "destination": "/#compartidas",
      "permanent": true
    },
    {
      "source": "/ofertas",
      "destination": "/#cotizar",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}